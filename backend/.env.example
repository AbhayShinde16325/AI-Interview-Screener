# ============================================================
# AI Interview Screener — Backend Environment Variables
# Copy this file to `.env` and fill in real values.
# ============================================================

# --- Database --------------------------------------------------
# Option A: full connection string (recommended — used by Neon, Render, etc.)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Option B: individual parts (used only when DATABASE_URL is empty)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=interview_screener
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres

# --- AI ----------------------------------------------------------
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# --- JWT ----------------------------------------------------------
# Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Application ---------------------------------------------------
# Directory (relative to backend/) used only while PDFs are being parsed.
# The original PDF is deleted immediately; extracted data is saved in PostgreSQL.
# UPLOAD_DIR=uploads
